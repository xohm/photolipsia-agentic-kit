{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(./node_modules/**)",
      "Edit(./node_modules/**)",
      "Read(./public/splats/**)",
      "Edit(./public/splats/**)",
      "Edit(./.check/**)"
    ]
  }
}
